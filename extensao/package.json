{
  "name": "php-tipos",
  "displayName": "PHP Tipos",
  "description": "Ícones em anel para classe, interface, trait e enum, e criação rápida de arquivos PHP, Laravel (CRUD completo) e Blade pelo botão direito.",
  "version": "1.0.0",
  "publisher": "cleversonnobrega",
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Themes",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "php",
    "laravel",
    "blade",
    "icons",
    "icon theme",
    "scaffold",
    "crud",
    "migration",
    "model",
    "controller",
    "eloquent",
    "namespace",
    "psr-4",
    "class",
    "interface",
    "trait",
    "enum",
    "pt-br"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "homepage": "https://github.com/cleversonNobrega/vscode-php-tipos#readme",
  "bugs": {
    "url": "https://github.com/cleversonNobrega/vscode-php-tipos/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cleversonNobrega/vscode-php-tipos.git",
    "directory": "extensao"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionDependencies": [
    "pkief.material-icon-theme"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "iconThemes": [
      {
        "id": "php-tipos-icones",
        "label": "Material + PHP Tipos (anel)",
        "path": "./tema.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "phpTipos.novo.arquivo",
        "title": "Arquivo PHP"
      },
      {
        "command": "phpTipos.novo.controller",
        "title": "Controller (vazio)"
      },
      {
        "command": "phpTipos.novo.class",
        "title": "Classe"
      },
      {
        "command": "phpTipos.novo.interface",
        "title": "Interface"
      },
      {
        "command": "phpTipos.novo.trait",
        "title": "Trait"
      },
      {
        "command": "phpTipos.novo.enum",
        "title": "Enum"
      },
      {
        "command": "phpTipos.novo.controllerResource",
        "title": "Controller resource (CRUD)"
      },
      {
        "command": "phpTipos.novo.model",
        "title": "Model"
      },
      {
        "command": "phpTipos.novo.migration",
        "title": "Migration"
      },
      {
        "command": "phpTipos.novo.request",
        "title": "Request (FormRequest)"
      },
      {
        "command": "phpTipos.novo.service",
        "title": "Service"
      },
      {
        "command": "phpTipos.novo.blade",
        "title": "View em branco"
      },
      {
        "command": "phpTipos.novo.bladeLayout",
        "title": "View com @extends('layouts.app')"
      },
      {
        "command": "phpTipos.blade.layoutBase",
        "title": "Layout base (layouts/app)"
      },
      {
        "command": "phpTipos.blade.listagem",
        "title": "Listagem (index) com tabela"
      },
      {
        "command": "phpTipos.blade.formulario",
        "title": "Formulário (criar e editar)"
      },
      {
        "command": "phpTipos.blade.detalhe",
        "title": "Detalhe (show)"
      },
      {
        "command": "phpTipos.blade.componente",
        "title": "Componente (x-nome)"
      },
      {
        "command": "phpTipos.novo.recursoCompleto",
        "title": "Recurso completo (Model, Migration, Request, Controller, Views)"
      }
    ],
    "submenus": [
      {
        "id": "phpTipos.submenu",
        "label": "Novo PHP"
      },
      {
        "id": "phpTipos.laravel",
        "label": "Novo Laravel"
      },
      {
        "id": "phpTipos.blade",
        "label": "Novo Blade"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "phpTipos.submenu",
          "when": "explorerResourceIsFolder && config.phpTipos.mostrarPhp",
          "group": "2_workspace@0"
        },
        {
          "submenu": "phpTipos.laravel",
          "when": "explorerResourceIsFolder && config.phpTipos.mostrarLaravel",
          "group": "2_workspace@1"
        },
        {
          "submenu": "phpTipos.blade",
          "when": "explorerResourceIsFolder && config.phpTipos.mostrarBlade && (config.phpTipos.mostrarTudo || resourcePath =~ /views/)",
          "group": "2_workspace@2"
        }
      ],
      "phpTipos.submenu": [
        {
          "command": "phpTipos.novo.arquivo",
          "group": "1@0"
        },
        {
          "command": "phpTipos.novo.class",
          "group": "1@2"
        },
        {
          "command": "phpTipos.novo.interface",
          "group": "1@3"
        },
        {
          "command": "phpTipos.novo.trait",
          "group": "1@4"
        },
        {
          "command": "phpTipos.novo.enum",
          "group": "1@5"
        }
      ],
      "commandPalette": [
        {
          "command": "phpTipos.novo.arquivo",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.controller",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.class",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.interface",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.trait",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.enum",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.controllerResource",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.model",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.migration",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.request",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.service",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.blade",
          "when": "false"
        },
        {
          "command": "phpTipos.novo.bladeLayout",
          "when": "false"
        },
        {
          "command": "phpTipos.blade.layoutBase",
          "when": "false"
        },
        {
          "command": "phpTipos.blade.listagem",
          "when": "false"
        },
        {
          "command": "phpTipos.blade.formulario",
          "when": "false"
        },
        {
          "command": "phpTipos.blade.detalhe",
          "when": "false"
        },
        {
          "command": "phpTipos.blade.componente",
          "when": "false"
        }
      ],
      "phpTipos.laravel": [
        {
          "command": "phpTipos.novo.recursoCompleto",
          "group": "1@0"
        },
        {
          "command": "phpTipos.novo.controller",
          "group": "2@0",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /Controllers/"
        },
        {
          "command": "phpTipos.novo.controllerResource",
          "group": "2@1",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /Controllers/"
        },
        {
          "command": "phpTipos.novo.model",
          "group": "2@2",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /Models/"
        },
        {
          "command": "phpTipos.novo.migration",
          "group": "2@3",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /migrations/"
        },
        {
          "command": "phpTipos.novo.request",
          "group": "2@4",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /Requests/"
        },
        {
          "command": "phpTipos.novo.service",
          "group": "2@5",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /Services/"
        }
      ],
      "phpTipos.blade": [
        {
          "command": "phpTipos.blade.layoutBase",
          "group": "1@0",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.blade.listagem",
          "group": "1@1",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.blade.formulario",
          "group": "1@2",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.blade.detalhe",
          "group": "1@3",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.blade.componente",
          "group": "1@4",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.novo.bladeLayout",
          "group": "1@5",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        },
        {
          "command": "phpTipos.novo.blade",
          "group": "1@6",
          "when": "config.phpTipos.mostrarTudo || resourcePath =~ /views/"
        }
      ]
    },
    "configuration": {
      "title": "PHP Tipos",
      "properties": {
        "phpTipos.mostrarPhp": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o submenu \"Novo PHP\" (Arquivo PHP, Classe, Interface, Trait, Enum) no botão direito das pastas."
        },
        "phpTipos.mostrarLaravel": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o submenu \"Novo Laravel\" (Recurso completo, Model, Migration, Request, Service, Controller) no botão direito das pastas."
        },
        "phpTipos.mostrarBlade": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o submenu \"Novo Blade\" (layout, listagem, formulário, detalhe, componente, view) no botão direito das pastas."
        },
        "phpTipos.mostrarTudo": {
          "type": "boolean",
          "default": false,
          "description": "Mostra todos os itens de Novo PHP/Laravel/Blade em qualquer pasta (por padrão cada item só aparece na pasta que combina: Controllers, Models, migrations, Requests, Services, views)."
        },
        "phpTipos.atualizarIconesSozinho": {
          "type": "boolean",
          "default": true,
          "description": "Depois de criar/apagar arquivos PHP, troca o tema de ícones por um instante para o VS Code reler os ícones C/I/T/E sem recarregar a janela."
        },
        "phpTipos.plural": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en"
          ],
          "default": "pt-BR",
          "description": "Regra de plural usada para tabela, rota e variáveis (contato → contatos, item → itens, ação → ações). Use 'en' para o plural do inglês (lead → leads, category → categories)."
        },
        "phpTipos.pluraisPersonalizados": {
          "type": "object",
          "default": {},
          "description": "Exceções de plural, por Model. Ex.: { \"Pessoa\": \"pessoas\", \"Mao\": \"maos\" }",
          "additionalProperties": {
            "type": "string"
          }
        },
        "phpTipos.strictTypes": {
          "type": "boolean",
          "default": true,
          "description": "Gera declare(strict_types=1); nos arquivos PHP novos."
        },
        "phpTipos.layoutPadrao": {
          "type": "string",
          "default": "layouts.app",
          "description": "Nome da view de layout usada nas telas Blade quando o projeto não tem uma pasta resources/views/layouts."
        }
      }
    }
  }
}
